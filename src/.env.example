# Copy to src/.env and fill in. Keep the file private: chmod 600 src/.env

# Outlook (Azure app registration)
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_SUBJECT=Notificación de transacción

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# MySQL (also read by docker compose)
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Optional overrides (defaults shown)
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=app_user
# DB_NAME=finance_db
# LOCAL_TZ=America/Costa_Rica
# USD_TO_CRC_RATE=500
# ALERT_MAX_AGE_HOURS=72
# FAILURE_ALERT_AFTER=3
# HEARTBEAT_HOUR=8
# ALLOWED_SENDERS=notificacion@notificacionesbaccr.com,notificacion@baccredomatic.cr,notificacionbac@baccredomatic.cr

# Gmail (legacy import)
GMAIL_QUERY=subject:"Notificación de transacción" bac
DEFAULT_START_DATE=2026/01/01
